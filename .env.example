# ============================================================
# JARVIS.ID — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
#   cp .env.example .env.local
#
# DO NOT commit .env.local. DO NOT include real credentials in ZIP exports.
# ============================================================

# ---- Database (Prisma + SQLite for sandbox demo) ----
# Production: replace with Supabase connection string if migrating to Supabase Prisma.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ---- Supabase (production backend) ----
# Get these from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Site URL ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- WhatsApp (official JARVIS.ID number) ----
# Do NOT change this number — it is the official business WhatsApp.
WHATSAPP_NUMBER=6285189976233

# ---- Storage bucket name (Supabase Storage) ----
STORAGE_BUCKET=service-media

# ---- Bank info (for transfer payments) ----
# Leave empty if you want admin to share bank details via WhatsApp manually.
BANK_NAME=
ACCOUNT_NAME=
ACCOUNT_NUMBER=

# ---- WhatsApp Business Cloud API (optional, MODE 2 in spec) ----
# If configured, the app can send media messages programmatically.
# If empty, the app falls back to wa.me links with media URLs (MODE 1).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---- Admin (sandbox demo only — production uses Supabase Auth) ----
# These credentials are used by the sandbox demo login form.
# Production: replace with Supabase Auth (Dashboard → Authentication → Users).
ADMIN_EMAIL=admin@jarvis.id
ADMIN_PASSWORD=jarvis2026
NEXT_PUBLIC_ADMIN_EMAIL=admin@jarvis.id
NEXT_PUBLIC_ADMIN_PASSWORD=jarvis2026

# ---- Session secret (sandbox demo only) ----
# Used to sign admin session cookies. Change to a long random string in production.
SESSION_SECRET=jarvis-id-dev-session-secret-change-me
