// JARVIS.ID — Prisma schema (Sandbox demo uses SQLite; production uses Supabase PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================
// SERVICE ORDERS
// =====================
model ServiceOrder {
  id                String   @id @default(cuid())
  orderNumber       String   @unique
  serviceArea       String   // ON_SITE | SEND_DEVICE
  // Customer
  customerName      String
  customerPhone     String
  customerEmail     String?
  customerCity      String
  customerProvince  String
  // Device
  deviceBrand       String
  deviceModel       String
  imei              String?
  deviceCondition   String
  // Service
  serviceType       String   // JSON-encoded array of services
  serviceDetails    String?
  previousRepair    String?
  rootStatus        String?
  customRomStatus   String?  @map("custom_rom_status")
  waterExposure     String?
  droppedStatus     String?
  // Location (on-site)
  serviceAddress    String?
  serviceLandmark   String?
  latitude          Float?
  longitude         Float?
  mapsUrl           String?  @map("maps_url")
  preferredDate     String?
  preferredTime     String?
  // Shipping (send-device)
  shippingNotes     String?  @map("shipping_notes")
  // Payment
  paymentMethod     String   @map("payment_method") // CASH | TRANSFER
  paymentStatus     String   @default("UNPAID") @map("payment_status")
  // Status
  orderStatus       String   @default("NEW") @map("order_status")
  // Consent
  privacyConsent    Boolean  @default(false) @map("privacy_consent")
  // Timestamps
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  media             OrderMedia[]
  statusHistory     OrderStatusHistory[]
  notes             ServiceNote[]

  @@map("service_orders")
}

// =====================
// ORDER MEDIA (photos / videos / payment proof)
// =====================
model OrderMedia {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  fileType    String   // DAMAGE_PHOTO | DAMAGE_VIDEO | PAYMENT_PROOF
  fileName    String   @map("file_name")
  filePath    String   @map("file_path") // relative path under uploads/
  fileUrl     String   @map("file_url")  // served URL
  mimeType    String   @map("mime_type")
  fileSize    Int      @map("file_size") // bytes (SQLite has no bigint; Int is fine for demo)
  createdAt   DateTime @default(now()) @map("created_at")

  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_media")
}

// =====================
// ORDER STATUS HISTORY
// =====================
model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  oldStatus   String?  @map("old_status")
  newStatus   String   @map("new_status")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

// =====================
// SERVICE NOTES (admin/technician notes)
// =====================
model ServiceNote {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  note        String
  noteType    String   @default("GENERAL") @map("note_type") // GENERAL | TECHNICIAN | INSPECTION | ESTIMATE | PAYMENT | CUSTOMER
  createdAt   DateTime @default(now()) @map("created_at")

  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("service_notes")
}

// =====================
// ADMIN USER (simple session-based; production uses Supabase Auth)
// =====================
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}
